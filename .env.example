# Shopify (custom app installed on your store)
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_WEBHOOK_SECRET=            # the app's client secret; Shopify signs webhooks with it

# Stripe (use a test key, sk_test_..., while trying it out)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=             # whsec_..., written here by scripts/register_stripe_webhook.py
STRIPE_TOLERANCE_SECONDS=300

# Airtable
AIRTABLE_TOKEN=                    # personal access token: data.records:read/write, schema.bases:read/write
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE=Orders

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_MODE=claude                     # or "rules" for no AI
HIGH_VALUE_THRESHOLD=500

# Team email: console | resend | smtp | command
NOTIFIER=console
NOTIFY_TO=team@example.com
NOTIFY_FROM=Orders <orders@example.com>
SUBJECT_PREFIX=
# RESEND_API_KEY=
# SMTP_HOST= SMTP_PORT=587 SMTP_USERNAME= SMTP_PASSWORD=
# NOTIFY_COMMAND=/path/to/your/mail-script   (called as: <command> <to> <subject> <body_file>)

# Klaviyo (optional): customer profile + 'Placed Order' / 'Started Checkout' events.
# Private key with Profiles and Events read/write. Never subscribes anyone to marketing.
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_REVISION=2026-10-15
KLAVIYO_DRY_RUN=                   # 1 = build and log the Klaviyo calls, send nothing

# Failure alerts (Slack-style incoming webhook, optional; alerts also go by email)
ALERT_WEBHOOK_URL=

EVENT_DB=data/events.sqlite3
HOST=127.0.0.1
PORT=8000
